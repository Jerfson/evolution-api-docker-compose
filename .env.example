# ==========================================
# EVOLUTION API - TEMPLATE DE CONFIGURAÇÃO (.env.example)
# Copie para .env antes de subir a stack:  Copy-Item .env.example .env
# ==========================================

# SERVER
SERVER_URL=http://localhost:8080
SERVER_PORT=8080

# AUTENTICAÇÃO GLOBAL
# TROQUE OBRIGATORIAMENTE antes de usar. Para gerar uma chave (PowerShell):
#   -join ((1..16) | ForEach-Object { '{0:x2}' -f (Get-Random -Minimum 0 -Maximum 256) })
AUTHENTICATION_TYPE=apikey
AUTHENTICATION_API_KEY=INSIRA_SUA_CHAVE_AQUI
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# BANCO DE DADOS (POSTGRESQL)
POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=evolution_pass

DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:evolution_pass@evolution-postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange

DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true
DATABASE_SAVE_IS_ON_WHATSAPP=true
DATABASE_SAVE_IS_ON_WHATSAPP_DAYS=7
DATABASE_DELETE_MESSAGE=true

# CACHE / REDIS
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/1
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false

# CONFIGURAÇÕES GERAIS
DEL_INSTANCE=false
CONFIG_SESSION_PHONE_CLIENT=Evolution API

# LOGS
# A lista completa é útil em desenvolvimento. Em produção use ERROR,WARN.
LOG_LEVEL=ERROR,WARN,DEBUG,INFO,LOG,VERBOSE,DARK,WEBHOOKS,WEBSOCKET
LOG_COLOR=true
LOG_BAILEYS=error

# CORS
# DEIXE "*". Restringir para uma origem faz o middleware de CORS rejeitar TODA
# requisição sem header Origin (curl, /docs, webhooks, chamadas do n8n) com:
#   500 {"message":"Not allowed by CORS"}
# O navegador manda Origin e continua funcionando, então o erro só aparece fora dele.
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

# ==========================================
# VERSÕES DAS IMAGENS (opcional)
# ==========================================
# O docker-compose.yaml já fixa uma versão da Evolution API. Descomente para
# trocar a versão sem editar o compose.
#
# ATENÇÃO: o Prisma não faz downgrade de migrações. Se o volume postgres_data
# já foi migrado por uma versão mais nova (a tag "latest" do evolution-api é um
# build posterior à v2.3.7), voltar para v2.3.7 pode falhar. Nesse caso, ou
# mantenha a versão anterior aqui, ou recrie o ambiente com `docker compose down -v`.
#
# EVOLUTION_API_IMAGE=evoapicloud/evolution-api:v2.3.7
